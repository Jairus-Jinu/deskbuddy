# DeskBuddy voice pipeline — local secrets. Gitignored.
# Free Groq key (no credit card): https://console.groq.com/keys
GROQ_API_KEY=

# Which backend to use: groq (default) or gemini
DESKBUDDY_PROVIDER=groq

# --- Groq settings -----------------------------------------------------------
# STT model (Whisper on Groq) and reply model
# DESKBUDDY_STT_MODEL=whisper-large-v3-turbo
# DESKBUDDY_LLM_MODEL=openai/gpt-oss-20b

# --- TTS settings ------------------------------------------------------------
# piper = local, offline, free (default)  |  groq = cloud voice
# DESKBUDDY_TTS_ENGINE=piper
# Piper voice name (en_US-lessac-medium, en_US-amy-medium, en_GB-alba-medium)
# DESKBUDDY_TTS_VOICE=en_US-lessac-medium

# --- Gemini fallback (only if DESKBUDDY_PROVIDER=gemini) ---------------------
# GEMINI_API_KEY=
# DESKBUDDY_TTS_MODEL=gemini-3.8-flash-lite-tts
