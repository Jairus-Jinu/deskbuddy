# DeskBuddy voice pipeline — local secrets. Gitignored.
# Free Groq key (no credit card): https://console.groq.com/keys
GROQ_API_KEY=

# Which backend to use: groq (default) or gemini
DESKBUDDY_PROVIDER=groq

# --- Groq settings -----------------------------------------------------------
# STT model (Whisper on Groq) and reply model
# DESKBUDDY_STT_MODEL=whisper-large-v3-turbo
# DESKBUDDY_LLM_MODEL=openai/gpt-oss-20b

# --- TTS settings ------------------------------------------------------------
# kokoro = local, offline, expressive (default) | piper = local, flatter
# groq = cloud voice (needs terms accepted at console.groq.com)
# DESKBUDDY_TTS_ENGINE=kokoro
# Kokoro voice: af_heart (default), af_bella, af_nicole, am_michael, bf_emma
# DESKBUDDY_TTS_VOICE=af_heart

# --- Wake word ---------------------------------------------------------------
# Spoken to start a conversation. Default "choom".
# DESKBUDDY_WAKE_WORD=choom

# --- Gemini fallback (only if DESKBUDDY_PROVIDER=gemini) ---------------------
# GEMINI_API_KEY=
# DESKBUDDY_TTS_MODEL=gemini-3.8-flash-lite-tts

# --- Persona ----------------------------------------------------------------
# DESKBUDDY_SYSTEM_PROMPT=
